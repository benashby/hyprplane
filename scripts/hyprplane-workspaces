#!/usr/bin/env bash
# hyprplane-workspaces — waybar custom module for hyprplane
#
# Long-running continuous exec. Outputs one JSON line per workspace event
# so waybar updates instantly. Add to your waybar config:
#
#   "custom/hyprplane-workspaces": {
#     "exec":           "hyprplane-workspaces",
#     "return-type":    "json",
#     "markup":         true,
#     "on-scroll-up":   "echo prev > $XDG_RUNTIME_DIR/hyprplane.fifo",
#     "on-scroll-down": "echo next > $XDG_RUNTIME_DIR/hyprplane.fifo",
#     "on-click-right": "your-hyprplane-launcher-script",
#     "tooltip":        true
#   }

STATE_FILE="${XDG_RUNTIME_DIR}/hyprplane.json"

# ── colors (Catppuccin Mocha) ─────────────────────────────────────────────────
ACTIVE_FG='#cba6f7'   # mauve    — active workspace (slot or named)
NAMED_FG='#89b4fa'    # blue     — inactive named slots
STATIC_FG='#94e2d5'   # teal     — inactive persistent workspaces
NUM_FG='#6c7086'      # overlay0 — inactive numeric-only slots
SEP_FG='#45475a'      # surface1 — slot-to-slot separator
SEP="<span foreground=\"${SEP_FG}\">  ·  </span>"
SECTION_SEP="<span foreground=\"${SEP_FG}\">  │  </span>"

# ── rendering ─────────────────────────────────────────────────────────────────

render() {
  if [[ ! -f "$STATE_FILE" ]]; then
    printf '{"text":"","tooltip":"hyprplane not running","class":"hyprplane-ws-inactive"}\n'
    return
  fi

  local current_name current_index slots base all_planes
  current_name=$(jq -r  '.current'             < "$STATE_FILE")
  current_index=$(jq -r '.currentIndex'         < "$STATE_FILE")
  slots=$(jq -r         '.slots // 12'          < "$STATE_FILE")
  base=$(( current_index * 100 ))
  all_planes=$(jq -r    '.planes | join(" › ")' < "$STATE_FILE")

  local all_ws active_id
  all_ws=$(hyprctl workspaces -j 2>/dev/null || echo "[]")
  active_id=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // -9999')

  local parts=()
  for (( slot = 1; slot <= slots; slot++ )); do
    local ws_id=$(( base + slot ))
    local ws_name label is_named=0

    ws_name=$(jq -r --argjson id "$ws_id" '.[] | select(.id == $id) | .name' <<< "$all_ws" 2>/dev/null)

    # Show named slots as "N:name" so the slot number is always visible
    if [[ "$ws_name" =~ ^[0-9]+:[[:space:]](.+)$ ]]; then
      label="${slot}:${BASH_REMATCH[1]}"; is_named=1
    elif [[ -n "$ws_name" && "$ws_name" != "$slot" ]]; then
      label="${slot}:${ws_name}"; is_named=1
    else
      label="$slot"
    fi

    # Escape Pango entities — workspace names are user input
    label="${label//&/&amp;}"
    label="${label//</&lt;}"
    label="${label//>/&gt;}"

    if [[ "$ws_id" == "$active_id" ]]; then
      parts+=("<span foreground=\"${ACTIVE_FG}\" weight=\"bold\">[${label}]</span>")
    elif (( is_named )); then
      parts+=("<span foreground=\"${NAMED_FG}\">${label}</span>")
    else
      parts+=("<span foreground=\"${NUM_FG}\">${label}</span>")
    fi
  done

  local text
  text=$(printf "%s${SEP}" "${parts[@]}"); text="${text%${SEP}}"

  # ── persistent (named) workspaces ──────────────────────────────────────────
  local static_parts=()
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    local ws_id label
    ws_id=$(jq -r --arg n "$name" '.[] | select(.name == $n) | .id' <<< "$all_ws")

    # Escape Pango entities — workspace names are user input
    label="${name//&/&amp;}"; label="${label//</&lt;}"; label="${label//>/&gt;}"

    if [[ "$ws_id" == "$active_id" ]]; then
      static_parts+=("<span foreground=\"${ACTIVE_FG}\" weight=\"bold\">[${label}]</span>")
    else
      static_parts+=("<span foreground=\"${STATIC_FG}\">${label}</span>")
    fi
  done < <(jq -r '.persistentWorkspaces[]?' < "$STATE_FILE")

  if [[ ${#static_parts[@]} -gt 0 ]]; then
    local static_text
    static_text=$(printf "%s${SEP}" "${static_parts[@]}"); static_text="${static_text%${SEP}}"
    [[ -n "$text" ]] && text+="${SECTION_SEP}"
    text+="$static_text"
  fi

  jq -cn \
    --arg text    "$text" \
    --arg tooltip "plane: ${current_name}  ·  ${all_planes}" \
    --arg class   "hyprplane-workspaces" \
    '{text:$text, tooltip:$tooltip, class:$class}'
}

# ── event loop ────────────────────────────────────────────────────────────────

discover_instance() {
  find "${XDG_RUNTIME_DIR}/hypr/" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
    | head -1 | xargs basename 2>/dev/null
}

render

while true; do
  SIG="${HYPRLAND_INSTANCE_SIGNATURE:-$(discover_instance)}"
  SOCKET="${XDG_RUNTIME_DIR}/hypr/${SIG}/.socket2.sock"

  if [[ -z "$SIG" || ! -S "$SOCKET" ]]; then
    sleep 2
    continue
  fi

  socat -U - "UNIX-CONNECT:${SOCKET}" | while IFS= read -r line; do
    event="${line%%>>*}"
    case "$event" in
      workspacev2|renameworkspace|createworkspacev2|destroyworkspacev2)
        render
        ;;
    esac
  done

  sleep 1
done
